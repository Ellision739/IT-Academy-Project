{
  "model": "catalog.author",
  "pk": 1,
  "fields": {
    "name": "Лев Толстой",
    "bio": "Автор монументальных произведений. Наиболее известны роман-эпопея «Война и мир» и трагедия «Анна Каренина»."
  }
},
{
  "model": "catalog.author",
  "pk": 2,
  "fields": {
    "name": "Фёдор Достоевский",
    "bio": "Мастер глубокого психологизма. Главные шедевры — «Преступление и наказание» и «Братья Карамазовы»."
  }
},
{
  "model": "catalog.author",
  "pk": 3,
  "fields": {
    "name": "Антон Чехов",
    "bio": "Гений короткого рассказа и драматургии. Знаковые тексты — пьеса «Чайка» и повесть «Палата № 6»."
  }
},
{
  "model": "catalog.author",
  "pk": 4,
  "fields": {
    "name": "Михаил Булгаков",
    "bio": "Мистик и сатирик. Его главный бестселлер — роман «Мастер и Маргарита»."
  }
},
{
  "model": "catalog.author",
  "pk": 5,
  "fields": {
    "name": "Александр Пушкин",
    "bio": "Основоположник современного русского литературного языка. Среди самых читаемых — роман в стихах «Евгений Онегин» и повесть «Капитанская дочка»."
  }
},
{
  "model": "catalog.author",
  "pk": 6,
  "fields": {
    "name": "Илья Ильф",
    "bio": "Русский советский писатель, драматург и сценарист, фотограф, журналист.\r\n\r\nЗначительная часть художественной прозы была написана Ильфом в соавторстве с Евгением Петровым, в том числе романы «Двенадцать стульев» и «Золотой телёнок», книга «Одноэтажная Америка», ряд киносценариев, повести, очерки, водевили. Произведения Ильфа и Петрова были переведены на десятки языков мира, выдержали большое количество переизданий, неоднократно экранизировались и инсценировались."
  }
},
{
  "model": "catalog.author",
  "pk": 7,
  "fields": {
    "name": "Евгений Петров",
    "bio": "Русский советский писатель, сценарист и драматург, журналист, военный корреспондент. Кавалер ордена Ленина. Член ВКП с 1939 года."
  }
},
{
  "model": "catalog.book",
  "pk": 1,
  "fields": {
    "title": "Война и мир",
    "isbn": "1",
    "description": "Два тома в одном",
    "genre": "classic",
    "authors": [
      1
    ]
  }
},
{
  "model": "catalog.book",
  "pk": 2,
  "fields": {
    "title": "Преступление и наказание",
    "isbn": "2",
    "description": "«Преступле́ние и наказа́ние» — социально-психологический и социально-философский роман Фёдора Михайловича Достоевского, над которым писатель работал в 1865—1866 годах. Впервые опубликован в 1866 году в журнале «Русский вестник».",
    "genre": "classic",
    "authors": [
      2
    ]
  }
},
{
  "model": "catalog.book",
  "pk": 3,
  "fields": {
    "title": "Палата №6",
    "isbn": "3",
    "description": "Главный врач провинциальной психиатрической больницы Рагин обнаруживает в одном из своих пациентов (Громове) человека с оригинальным мышлением, более того – собственной философией. В беседах с душевнобольным доктор видит безумие мира и скоро сам теряет рассудок. Но кто вправе решать, где та грань, за которой начинается безумие?",
    "genre": "drama",
    "authors": [
      3
    ]
  }
},
{
  "model": "catalog.book",
  "pk": 4,
  "fields": {
    "title": "Капитанская дочка",
    "isbn": "4",
    "description": "«Капита́нская до́чка» — исторический роман Александра Пушкина, действие которого происходит во время восстания Емельяна Пугачёва. Впервые был опубликован без указания имени автора в 4-й книжке журнала «Современник», поступившей в продажу в последней декаде 1836 года.",
    "genre": "romance",
    "authors": [
      5
    ]
  }
},
{
  "model": "catalog.book",
  "pk": 5,
  "fields": {
    "title": "Двенадцать стульев",
    "isbn": "5",
    "description": "«Двена́дцать сту́льев» — роман Ильи Ильфа и Евгения Петрова, написанный в 1927 году и являющийся первой совместной работой соавторов. В 1928 году опубликован в художественно-литературном журнале «Тридцать дней» (№ 1—7); в том же году издан отдельной книгой. В основе сюжета — поиски бриллиантов, спрятанных в одном из двенадцати стульев мадам Петуховой, однако история, изложенная в произведении, не ограничена рамками приключенческого жанра: в ней, по мнению исследователей, дан «глобальный образ эпохи».",
    "genre": "historical",
    "authors": [
      6,
      7
    ]
  }
},
